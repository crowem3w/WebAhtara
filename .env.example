# Copy to .env and change every value before deploying.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the admin is served through a reverse proxy over https.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# Origins allowed to call the API from a browser (your Next.js site).
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://ahtara:ahtara@db:5432/ahtara
POSTGRES_PASSWORD=ahtara
# Lowest trust tier shown by the public API: 0 unverified, 1 source_listed, 2 registry_checked, 3 owner_verified
PUBLIC_MIN_TIER=1
